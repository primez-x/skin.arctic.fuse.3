<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Button_Divider_Label">
        <definition>
            <control type="label" id="$PARAM[id]">
                <nested />
                <align>left</align>
                <font>font_hint_bold</font>
                <top>40</top>
                <height>40</height>
                <textoffsetx>20</textoffsetx>
                <textcolor>dialog_fg_30</textcolor>
            </control>
        </definition>
    </include>

    <include name="Button_Dialog_Setting">
        <param name="control">button</param>
        <param name="dialog">true</param>
        <param name="istext">false</param>
        <param name="top">-pill_pitch</param>
        <param name="font">font_mini</param>
        <definition>
            <include content="Button_Dialog">
                <param name="id">$PARAM[id]</param>
                <param name="groupid">$PARAM[groupid]</param>
                <param name="control">$PARAM[control]</param>
                <param name="dialog">$PARAM[dialog]</param>
                <param name="label">$PARAM[label]</param>
                <param name="icon">$PARAM[icon]</param>
                <param name="font">$PARAM[font]</param>
                <param name="top">$PARAM[top]</param>
                <param name="left">$PARAM[left]</param>
                <param name="istext">$PARAM[istext]</param>
                <param name="has_label2">$PARAM[has_label2]</param>
                <param name="label2">$PARAM[label2]</param>
                <label>$PARAM[label]</label>
                <label2>$PARAM[label2]</label2>
                <texturenofocus />
                <nested />
            </include>
        </definition>
    </include>

    <include name="Button_Dialog">
        <param name="control">button</param>
        <param name="dialog">true</param>
        <param name="istext">false</param>
        <definition>
            <include content="Button_Control">
                <param name="id">$PARAM[id]</param>
                <param name="control">$PARAM[control]</param>
                <param name="dialog">$PARAM[dialog]</param>
                <radioposx>-2</radioposx>
                <font />
                <nested />
            </include>
            <include content="Button_Image" condition="![$PARAM[istext]]">
                <param name="id">$PARAM[groupid]</param>
                <param name="buttonid">$PARAM[id]</param>
                <param name="icon">$PARAM[icon]</param>
                <param name="font">$PARAM[font]</param>
                <param name="top">$PARAM[top]</param>
                <param name="left">$PARAM[left]</param>
                <param name="has_label2">$PARAM[has_label2]</param>
                <param name="label2">$PARAM[label2]</param>
            </include>
            <include content="Button_Label" condition="$PARAM[istext]">
                <param name="id">$PARAM[groupid]</param>
                <param name="buttonid">$PARAM[id]</param>
                <param name="label">$PARAM[label]</param>
                <param name="font">$PARAM[font]</param>
                <param name="top">$PARAM[top]</param>
                <param name="left">$PARAM[left]</param>
                <param name="has_label2">$PARAM[has_label2]</param>
                <param name="label2">$PARAM[label2]</param>
            </include>
        </definition>
    </include>

    <include name="Button_Control">
        <param name="control">button</param>
        <param name="dialog">false</param>
        <param name="window" />
        <param name="reload">false</param>
        <param name="slevel">0</param>
        <definition>
            <control type="$PARAM[control]" id="$PARAM[baseid]$PARAM[id]">
                <nested />
                <align>left</align>
                <font>font_mini</font>
                <height>pill_h</height>
                <textoffsetx>72</textoffsetx>
                <include condition="$PARAM[dialog]">defs_dialog_$PARAM[control]</include>
                <include content="Settings_Button_$PARAM[window]">
                    <param name="id">$PARAM[id]</param>
                    <param name="baseid">$PARAM[baseid]</param>
                    <param name="reload">$PARAM[reload]</param>
                    <param name="slevel">$PARAM[slevel]</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Button_Label_Controls_Objects">
        <control type="$PARAM[control]">
            <aligny>center</aligny>
            <align>$PARAM[align]</align>
            <font>$PARAM[font]</font>
            <textcolor>dialog_fg_70</textcolor>
            <label>$PARAM[label]</label>
            <visible>!Control.HasFocus($PARAM[buttonid])</visible>
        </control>
        <control type="$PARAM[control]">
            <aligny>center</aligny>
            <align>$PARAM[align]</align>
            <font>$PARAM[font]</font>
            <textcolor>$VAR[ColorSelected]</textcolor>
            <label>$PARAM[label]</label>
            <visible>Control.HasFocus($PARAM[buttonid])</visible>
        </control>
    </include>

    <include name="Button_Label_Controls">
        <param name="control">textbox</param>
        <param name="font">font_mini_bold</param>
        <param name="left">20</param>
        <param name="has_label2">false</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <control type="group">
                    <centertop>50%</centertop>
                    <left>52</left>
                    <height>pill_h</height>
                    <right>pill_pad_x</right>
                    <include content="Button_Label_Controls_Objects" condition="![$PARAM[has_label2]]">
                        <param name="control">$PARAM[control]</param>
                        <param name="font">$PARAM[font]</param>
                        <param name="label">$PARAM[label]</param>
                        <param name="buttonid">$PARAM[buttonid]</param>
                        <param name="align">left</param>
                    </include>
                    <include content="Button_Label_Controls_Objects" condition="$PARAM[has_label2]">
                        <param name="control">label</param>
                        <param name="font">$PARAM[font]</param>
                        <param name="label">$PARAM[label]</param>
                        <param name="buttonid">$PARAM[buttonid]</param>
                        <param name="align">left</param>
                    </include>
                    <include content="Button_Label_Controls_Objects" condition="$PARAM[has_label2]">
                        <param name="control">label</param>
                        <param name="font">$PARAM[font]</param>
                        <param name="label">$PARAM[label2]</param>
                        <param name="buttonid">$PARAM[buttonid]</param>
                        <param name="align">right</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="Button_Image">
        <param name="top">-pill_pitch</param>
        <param name="left">20</param>
        <definition>
            <control type="group" id="$PARAM[id]">
                <top>$PARAM[top]</top>
                <height>pill_h</height>
                <visible>Control.IsVisible($PARAM[buttonid])</visible>
                <control type="group">
                    <centertop>50%</centertop>
                    <left>$PARAM[left]</left>
                    <width>32</width>
                    <height>32</height>
                    <control type="image">
                        <bordersize>icon_home_bordersize</bordersize>
                        <texture colordiffuse="dialog_fg_70">$PARAM[icon]</texture>
                        <visible>!Control.HasFocus($PARAM[buttonid])</visible>
                    </control>
                    <control type="image">
                        <bordersize>icon_home_bordersize</bordersize>
                        <texture colordiffuse="$VAR[ColorSelected]">$PARAM[icon]</texture>
                        <visible>Control.HasFocus($PARAM[buttonid])</visible>
                    </control>
                </control>
                <include content="Button_Label_Controls">
                    <param name="label">$INFO[Control.GetLabel($PARAM[buttonid])]</param>
                    <param name="buttonid">$PARAM[buttonid]</param>
                    <param name="font">$PARAM[font]</param>
                    <param name="top">$PARAM[top]</param>
                    <param name="left">$PARAM[left]</param>
                    <param name="has_label2">$PARAM[has_label2]</param>
                    <param name="label2">$PARAM[label2]</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Button_Label">
        <param name="top">-pill_pitch</param>
        <definition>
            <control type="group" id="$PARAM[id]">
                <top>$PARAM[top]</top>
                <height>pill_h</height>
                <visible>Control.IsVisible($PARAM[buttonid])</visible>
                <include content="Button_Label_Controls">
                    <param name="label">$PARAM[label]</param>
                    <param name="buttonid">$PARAM[buttonid]</param>
                    <param name="font">$PARAM[font]</param>
                    <param name="has_label2">$PARAM[has_label2]</param>
                    <param name="label2">$PARAM[label2]</param>
                </include>
            </control>
        </definition>
    </include>

    <include name="Button_Underline_Switcher">
        <param name="control">togglebutton</param>
        <definition>
            <control type="$PARAM[control]" id="$PARAM[id]">
                <nested />
                <width>auto</width>
                <aligny>top</aligny>
                <textoffsetx>0</textoffsetx>
                <font>font_main_bold</font>
                <textcolor>dialog_fg_30</textcolor>
                <focusedcolor>dialog_fg_100</focusedcolor>
                <include>Texture_Highlight_Underline_H</include>
            </control>
        </definition>
    </include>

    <!-- Native-height focusable pill used by the primary action row in detail dialogs. -->
    <include name="Button_DialogInfo_ActionPill">
        <param name="control">button</param>
        <param name="width">auto</param>
        <param name="align">center</param>
        <param name="textoffsetx">pill_pad_x</param>
        <param name="textcolor">dialog_fg_100</param>
        <param name="focusedcolor">$VAR[ColorSelected]</param>
        <param name="selectedcolor">dialog_fg_100</param>
        <definition>
            <control type="$PARAM[control]" id="$PARAM[id]">
                <nested />
                <width>$PARAM[width]</width>
                <height>pill_h</height>
                <align>$PARAM[align]</align>
                <aligny>center</aligny>
                <textoffsetx>$PARAM[textoffsetx]</textoffsetx>
                <font>font_mini_bold</font>
                <textcolor>$PARAM[textcolor]</textcolor>
                <focusedcolor>$PARAM[focusedcolor]</focusedcolor>
                <selectedcolor>$PARAM[selectedcolor]</selectedcolor>
                <include>Texture_DialogInfo_Action</include>
            </control>
        </definition>
    </include>

    <!-- Icon buttons grow into a labelled pill while focused.
         A pill_h (52px) focusable circle in the action grouplist. The overlay group that follows sits on top of
         the button: a -pill_pitch left plus 52 width cancels the pill_gap grouplist gap, so the overlay takes no space.
         The pill is a left cap, a middle strip that zooms open from the cap, and a right cap that slides with
         the strip's end. Kodi multiplies stacked zooms, so each width class has its own strip; pill_<size>
         selects the class from the label. The overlays of later buttons slide by the same growth (shift_<size>),
         so the row opens around the focused pill. A class fits a 24px Inter Bold caption of up to 104 (s), 140 (m),
         192 (l) or 244 (xl) pixels with 12px clear of the right curve. -->
    <include name="Button_DialogInfo_ActionIcon">
        <param name="pill_s">false</param>
        <param name="pill_m">false</param>
        <param name="pill_l">false</param>
        <param name="pill_xl">false</param>
        <param name="shift_s">false</param>
        <param name="shift_m">false</param>
        <param name="shift_l">false</param>
        <param name="shift_xl">false</param>
        <definition>
            <control type="button" id="$PARAM[id]">
                <width>pill_h</width>
                <height>110</height>
                <texturefocus />
                <texturenofocus />
                <label />
                <nested />
            </control>
            <!-- Grouplist navigation chains children by id, so the overlay needs one for focus to pass through -->
            <control type="group" id="$PARAM[id]9">
                <left>-pill_pitch</left>
                <width>pill_h</width>
                <height>110</height>
                <visible>Control.IsVisible($PARAM[id])</visible>
                <include content="Animation_DialogInfo_ActionShift">
                    <param name="shift_s">$PARAM[shift_s]</param>
                    <param name="shift_m">$PARAM[shift_m]</param>
                    <param name="shift_l">$PARAM[shift_l]</param>
                    <param name="shift_xl">$PARAM[shift_xl]</param>
                </include>
                <include content="Object_DialogInfo_ActionPillCap">
                    <param name="id">$PARAM[id]</param>
                </include>
                <include content="Object_DialogInfo_ActionPillStrip">
                    <param name="id">$PARAM[id]</param>
                    <param name="pill">$PARAM[pill_s]</param>
                    <param name="zoom">14100</param>
                </include>
                <include content="Object_DialogInfo_ActionPillStrip">
                    <param name="id">$PARAM[id]</param>
                    <param name="pill">$PARAM[pill_m]</param>
                    <param name="zoom">17700</param>
                </include>
                <include content="Object_DialogInfo_ActionPillStrip">
                    <param name="id">$PARAM[id]</param>
                    <param name="pill">$PARAM[pill_l]</param>
                    <param name="zoom">22900</param>
                </include>
                <include content="Object_DialogInfo_ActionPillStrip">
                    <param name="id">$PARAM[id]</param>
                    <param name="pill">$PARAM[pill_xl]</param>
                    <param name="zoom">28100</param>
                </include>
                <control type="group">
                    <left>27</left>
                    <width>26</width>
                    <include content="Animation_DialogInfo_ActionShift">
                        <param name="shift_s">Control.HasFocus($PARAM[id]) + [$PARAM[pill_s]]</param>
                        <param name="shift_m">Control.HasFocus($PARAM[id]) + [$PARAM[pill_m]]</param>
                        <param name="shift_l">Control.HasFocus($PARAM[id]) + [$PARAM[pill_l]]</param>
                        <param name="shift_xl">Control.HasFocus($PARAM[id]) + [$PARAM[pill_xl]]</param>
                    </include>
                    <include content="Object_DialogInfo_ActionPillCap">
                        <param name="id">$PARAM[id]</param>
                        <param name="flipx">true</param>
                    </include>
                </control>
                <control type="image">
                    <left>8</left>
                    <top>8</top>
                    <width>36</width>
                    <height>36</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="dialog_fg_100">$PARAM[icon]</texture>
                    <visible>!Control.HasFocus($PARAM[id])</visible>
                </control>
                <control type="image">
                    <left>8</left>
                    <top>8</top>
                    <width>36</width>
                    <height>36</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="$VAR[ColorSelected]">$PARAM[icon]</texture>
                    <visible>Control.HasFocus($PARAM[id])</visible>
                </control>
                <control type="label">
                    <left>50</left>
                    <width>260</width>
                    <height>pill_h</height>
                    <aligny>center</aligny>
                    <font>font_mini_bold</font>
                    <textcolor>$VAR[ColorSelected]</textcolor>
                    <label>$PARAM[label]</label>
                    <visible>Control.HasFocus($PARAM[id])</visible>
                    <animation type="Visible">
                        <effect type="fade" start="0" end="100" delay="90" time="140" />
                        <effect type="slide" start="-12,0" end="0" delay="90" time="140" tween="cubic" easing="out" />
                    </animation>
                </control>
            </control>
        </definition>
    </include>

    <!-- One half of the pill: glass while unfocused, the highlight while focused -->
    <include name="Object_DialogInfo_ActionPillCap">
        <param name="flipx">false</param>
        <definition>
            <control type="image">
                <width>26</width>
                <height>pill_h</height>
                <texture colordiffuse="dialog_fg_12" flipx="$PARAM[flipx]">common/halfcircle.png</texture>
                <visible>!Control.HasFocus($PARAM[id])</visible>
            </control>
            <control type="image">
                <width>26</width>
                <height>pill_h</height>
                <texture colordiffuse="$VAR[ColorHighlight]" flipx="$PARAM[flipx]">common/halfcircle.png</texture>
                <visible>Control.HasFocus($PARAM[id])</visible>
            </control>
        </definition>
    </include>

    <!-- The pill body between the caps. A control rests at its real size until a conditional animation runs,
         so the body is 1px wide at rest and zooms from the left cap to meet the slid right cap (zoom = (growth + 1) x 100%). -->
    <include name="Object_DialogInfo_ActionPillStrip">
        <definition>
            <control type="group">
                <left>26</left>
                <width>1</width>
                <height>pill_h</height>
                <visible>$PARAM[pill]</visible>
                <animation effect="zoom" start="100,100" end="$PARAM[zoom],100" center="26,26" time="200" tween="cubic" easing="out" condition="Control.HasFocus($PARAM[id])">Conditional</animation>
                <control type="image">
                    <width>1</width>
                    <height>pill_h</height>
                    <texture colordiffuse="dialog_fg_12">common/white.png</texture>
                    <visible>!Control.HasFocus($PARAM[id])</visible>
                </control>
                <control type="image">
                    <width>1</width>
                    <height>pill_h</height>
                    <texture colordiffuse="$VAR[ColorHighlight]">common/white.png</texture>
                    <visible>Control.HasFocus($PARAM[id])</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- Slides a later action right by the growth of the focused pill before it (Button_DialogInfo_ActionIcon) -->
    <include name="Animation_DialogInfo_ActionShift">
        <param name="shift_s">false</param>
        <param name="shift_m">false</param>
        <param name="shift_l">false</param>
        <param name="shift_xl">false</param>
        <definition>
            <animation effect="slide" end="140,0" time="200" tween="cubic" easing="out" condition="$PARAM[shift_s]">Conditional</animation>
            <animation effect="slide" end="176,0" time="200" tween="cubic" easing="out" condition="$PARAM[shift_m]">Conditional</animation>
            <animation effect="slide" end="228,0" time="200" tween="cubic" easing="out" condition="$PARAM[shift_l]">Conditional</animation>
            <animation effect="slide" end="280,0" time="200" tween="cubic" easing="out" condition="$PARAM[shift_xl]">Conditional</animation>
        </definition>
    </include>

    <!-- The foreground starts 20px left of the pill (the action grouplist sits 20 in). A 40px transparent native
         offset sizes the pill to the label plus 80: the 52px icon zone, a 4px gap, and 24px after the label. -->
    <include name="DialogInfo_PrimaryActionForeground">
        <param name="buttonid">4001</param>
        <param name="label" />
        <definition>
            <control type="image">
                <left>28</left>
                <top>8</top>
                <width>36</width>
                <height>36</height>
                <texture colordiffuse="$VAR[Color_DialogInfo_PlayIcon]">$VAR[Image_DialogInfo_PlayButton]</texture>
                <visible>!$EXP[Exp_DialogInfo_PlayResumes]</visible>
            </control>
            <!-- Resume: a thin progress ring around a play triangle. The ring frames draw a thick ring in the middle
                 half of the image; the diffuse mask keeps a 2px band of it at this size. -->
            <control type="group">
                <left>22</left>
                <top>2</top>
                <visible>$EXP[Exp_DialogInfo_PlayResumes]</visible>
                <control type="image">
                    <width>48</width>
                    <height>48</height>
                    <texture colordiffuse="$VAR[Color_DialogInfo_PlayRingTrack]" diffuse="progress/circle-thin-diffuse.png">progress/circle/p100.png</texture>
                </control>
                <control type="image">
                    <width>48</width>
                    <height>48</height>
                    <texture colordiffuse="$VAR[Color_DialogInfo_PlayIcon]" diffuse="progress/circle-thin-diffuse.png" flipx="true" flipy="true">$VAR[Label_DialogInfo_ResumePercent,progress/circle/p,.png]</texture>
                </control>
                <control type="image">
                    <left>8</left>
                    <top>8</top>
                    <width>32</width>
                    <height>32</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="$VAR[Color_DialogInfo_PlayIcon]">resource://resource.images.arctic.fuse.3/extras/icons/play2.png</texture>
                </control>
            </control>
            <control type="label">
                <left>76</left>
                <top>0</top>
                <width>auto</width>
                <height>pill_h</height>
                <align>left</align>
                <aligny>center</aligny>
                <font>font_mini_bold</font>
                <textcolor>dialog_fg_100</textcolor>
                <label>$PARAM[label]</label>
                <visible>!Control.HasFocus($PARAM[buttonid])</visible>
            </control>
            <control type="label">
                <left>76</left>
                <top>0</top>
                <width>auto</width>
                <height>pill_h</height>
                <align>left</align>
                <aligny>center</aligny>
                <font>font_mini_bold</font>
                <textcolor>$VAR[ColorSelected]</textcolor>
                <label>$PARAM[label]</label>
                <visible>Control.HasFocus($PARAM[buttonid])</visible>
            </control>
        </definition>
    </include>
</includes>
