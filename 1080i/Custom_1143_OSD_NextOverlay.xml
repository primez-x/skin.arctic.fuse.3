<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1143">
    <defaultcontrol always="true">6003</defaultcontrol>

    <controls>

        <control type="group">
            <include>OSD_HideControls</include>
            <control type="list" id="450">
                <left>-1920</left>
                <width>1</width>
                <height>1</height>
                <itemlayout width="1" height="1" />
                <focusedlayout width="1" height="1" />
                <content target="videos">$VAR[Path_OSD_NextRecommendation]</content>
            </control>

            <control type="group">
                <top>view_pad</top>
                <left>view_pad</left>
                <visible>!Container(450).IsUpdating</visible>
                <visible>!Integer.IsEqual(Container(450).NumItems,0)</visible>
                <visible>![!String.IsEmpty(Player.Chapter) + !String.IsEqual(Player.Chapter,00) + !String.IsEmpty(Player.ChapterCount) + !String.IsEqual(Player.ChapterCount,00) + !String.IsEqual(Player.Chapter,Player.ChapterCount)]</visible>
                <visible>Integer.IsLess(VideoPlayer.PlaylistPosition,VideoPlayer.PlaylistLength) | Integer.IsLess(Player.TimeRemaining(mins),10)</visible>
                <animation type="WindowOpen" reversible="true">
                    <effect type="fade" start="0" end="100" time="300" delay="600"/>
                    <effect type="slide" start="0,-48" end="0" center="auto" tween="back" easing="out" time="400" delay="600"/>
                </animation>
                <animation type="Visible" reversible="true">
                    <effect type="fade" start="0" end="100" time="300" delay="600"/>
                    <effect type="slide" start="0,-48" end="0" center="auto" tween="back" easing="out" time="400" delay="600"/>
                </animation>
                <control type="group">
                    <height>view_landscape_item_h</height>
                    <width>view_landscape_item_w</width>
                    <control type="group">
                        <include>Object_ItemBack</include>
                        <control type="image">
                            <texture background="true" diffuse="diffuse/landscape_w410_h231.png">$VAR[Image_OSD_UpNext_Playlist_Landscape]</texture>
                            <aspectratio scalediffuse="false">keep</aspectratio>
                        </control>
                        <!-- <param name="top_title">$VAR[Label_OSD_UpNext_Playlist_TopTitle]</param>
                        <param name="sub_title">$VAR[Label_OSD_UpNext_Playlist_SubTitle]</param> -->
                    </control>
                </control>
                <control type="grouplist">
                    <left>view_landscape_item_w</left>
                    <height>view_landscape_item_h</height>
                    <align>center</align>
                    <orientation>vertical</orientation>
                    <control type="label">
                        <left>40</left>
                        <textcolor>panel_fg_90</textcolor>
                        <label>$LOCALIZE[31196]$VAR[Label_OSD_UpNext_Playlist_TopTitle, - ,]</label>
                        <height>40</height>
                        <font>font_main_bold</font>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <textcolor>panel_fg_70</textcolor>
                        <label>$VAR[Label_OSD_UpNext_Playlist_SubTitle]</label>
                        <height>40</height>
                    </control>
                </control>
            </control>

            <control type="group">
                <right>view_pad</right>
                <bottom>230</bottom>
                <width>450</width>
                <height>92</height>
                <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.available))</visible>
                <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
                <visible>!Window.IsVisible(DialogSlider.xml)</visible>
                <animation type="WindowOpen" reversible="true">
                    <effect type="fade" start="0" end="100" time="220" delay="120"/>
                    <effect type="slide" start="0,28" end="0" center="auto" tween="cubic" easing="out" time="260" delay="120"/>
                </animation>
                <animation type="Visible" reversible="true">
                    <effect type="fade" start="0" end="100" time="220"/>
                    <effect type="slide" start="0,28" end="0" center="auto" tween="cubic" easing="out" time="260"/>
                </animation>
                <control type="image">
                    <width>450</width>
                    <height>82</height>
                    <texture border="44" colordiffuse="EE121316">common/circlebutton.png</texture>
                </control>
                <control type="progress">
                    <left>30</left>
                    <bottom>18</bottom>
                    <width>318</width>
                    <height>5</height>
                    <texturebg colordiffuse="main_fg_30" border="12,0,12,0">progress/progress-nib.png</texturebg>
                    <lefttexture />
                    <midtexture colordiffuse="$VAR[ColorHighlight]" border="12,0,12,0">progress/progress-nib.png</midtexture>
                    <righttexture />
                    <overlaytexture />
                    <info>Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_progress_percent)</info>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_progress_percent))</visible>
                </control>
                <control type="label">
                    <left>30</left>
                    <top>13</top>
                    <width>308</width>
                    <height>48</height>
                    <label>$VAR[Label_OSD_PKC_SkipMarker]</label>
                    <font>font_main_bold</font>
                    <textcolor>panel_fg_100</textcolor>
                    <shadowcolor>99000000</shadowcolor>
                    <aligny>center</aligny>
                </control>
                <control type="label">
                    <right>28</right>
                    <top>22</top>
                    <width>60</width>
                    <height>38</height>
                    <label>$INFO[Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining),,s]</label>
                    <font>font_tiny</font>
                    <textcolor>$VAR[ColorHighlight]</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <visible>!String.IsEmpty(Window(10000).Property(plugin.video.plexkodiconnect.skip_marker.hide_remaining))</visible>
                </control>
            </control>

            <control type="group">
                <left>view_pad</left>
                <right>view_pad</right>

                <visible>!Window.IsActive(DialogPlayerProcessInfo.xml)</visible>
                <visible>!Window.IsVisible(DialogSlider.xml)</visible>

                <include content="OSD_CustomDialog_GroupList">
                    <param name="onclick">$VAR[Action_OSD_SkipNext]</param>
                    <param name="icon">$VAR[Image_OSD_SkipNext]</param>
                    <param name="button_3">true</param>

                    <param name="onup">Close</param>
                    <param name="onup_02">SetFocus(8200)</param>

                </include>
            </control>
        </control>

    </controls>
</window>
