<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <include content="Object_DefaultControl">
        <param name="always">true</param>
        <param name="defaultcontrol">8000</param>
    </include>
    <menucontrol>9000</menucontrol>
    <include>DialogInfo_Onload</include>
    <onload>SetProperty(TMDbHelper.EnableExtendedProperties,True)</onload>
    <onload>SetProperty(BaseID,$INFO[ListItem.Label]$INFO[ListItem.FolderPath])</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.Identity,Home)</onload>
    <onload>SetProperty(PKC.Watchlist.Detail.State,unknown,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.PreviousState,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.Pending,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.RequestId,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.StatusRevision,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.Error,Home)</onload>
    <onload>CancelAlarm(pkc_watchlist_optimistic,true)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.OptimisticIdentity,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.OptimisticState,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.TMDbId,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.TMDbType,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.RatingKey,Home)</onload>
    <onload>ClearProperty(PKC.Watchlist.Detail.MonitorRevision,Home)</onload>
    <onload>SetProperty(PKC.Watchlist.Detail.Context.Label,$INFO[ListItem.Label],Home)</onload>
    <onload>SetProperty(PKC.Watchlist.Detail.Context.DBType,$INFO[ListItem.DBTYPE],Home)</onload>

    <onunload>ClearProperty(PKC.Watchlist.Detail.Identity,Home)</onunload>
    <onunload>CancelAlarm(pkc_watchlist_optimistic,true)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.OptimisticIdentity,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.OptimisticState,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.Revision,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.StatusRevision,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.RatingKey,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.MonitorRevision,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.Context.Label,Home)</onunload>
    <onunload>ClearProperty(PKC.Watchlist.Detail.Context.DBType,Home)</onunload>

    <!-- Native Plex Watchlist state: source it from Plex, never from a listing position. -->
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)] + !String.IsEmpty(ListItem.Property(ratingKey))">SetProperty(PKC.Watchlist.Detail.Identity,plex.$INFO[ListItem.Property(ratingKey)],Home)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)] + !String.IsEmpty(ListItem.Property(ratingKey))">RunPlugin(plugin://plugin.video.plexkodiconnect/?mode=watchlist_status_key&amp;rating_key=$INFO[ListItem.Property(ratingKey)]&amp;plex_type=$INFO[ListItem.DBTYPE]&amp;watchlist_hint=$INFO[ListItem.Property(PlexWatchlistHint)])</onload>

    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + !String.IsEmpty(ListItem.UniqueID(tmdb)) + String.IsEqual(ListItem.DBTYPE,movie)">SetProperty(PKC.Watchlist.Detail.Identity,tmdb.movie.$INFO[ListItem.UniqueID(tmdb)],Home)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + !String.IsEmpty(ListItem.UniqueID(tmdb)) + String.IsEqual(ListItem.DBTYPE,movie)">RunPlugin(plugin://plugin.video.plexkodiconnect/?mode=watchlist_status_tmdb&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]&amp;tmdb_type=movie)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + !String.IsEmpty(ListItem.UniqueID(tmdb)) + String.IsEqual(ListItem.DBTYPE,tvshow)">SetProperty(PKC.Watchlist.Detail.Identity,tmdb.tv.$INFO[ListItem.UniqueID(tmdb)],Home)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + !String.IsEmpty(ListItem.UniqueID(tmdb)) + String.IsEqual(ListItem.DBTYPE,tvshow)">RunPlugin(plugin://plugin.video.plexkodiconnect/?mode=watchlist_status_tmdb&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]&amp;tmdb_type=tvshow)</onload>

    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + String.IsEmpty(ListItem.UniqueID(tmdb)) + !String.IsEmpty(ListItem.Property(tmdb_id)) + String.IsEqual(ListItem.DBTYPE,movie)">SetProperty(PKC.Watchlist.Detail.Identity,tmdb.movie.$INFO[ListItem.Property(tmdb_id)],Home)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + String.IsEmpty(ListItem.UniqueID(tmdb)) + !String.IsEmpty(ListItem.Property(tmdb_id)) + String.IsEqual(ListItem.DBTYPE,movie)">RunPlugin(plugin://plugin.video.plexkodiconnect/?mode=watchlist_status_tmdb&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)]&amp;tmdb_type=movie)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + String.IsEmpty(ListItem.UniqueID(tmdb)) + !String.IsEmpty(ListItem.Property(tmdb_id)) + String.IsEqual(ListItem.DBTYPE,tvshow)">SetProperty(PKC.Watchlist.Detail.Identity,tmdb.tv.$INFO[ListItem.Property(tmdb_id)],Home)</onload>
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + String.IsEmpty(ListItem.UniqueID(tmdb)) + !String.IsEmpty(ListItem.Property(tmdb_id)) + String.IsEqual(ListItem.DBTYPE,tvshow)">RunPlugin(plugin://plugin.video.plexkodiconnect/?mode=watchlist_status_tmdb&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)]&amp;tmdb_type=tvshow)</onload>

    <!-- TMDb Helper publishes monitor identities asynchronously; validate freshness in PKC. -->
    <onload condition="System.AddonIsEnabled(plugin.video.plexkodiconnect) + String.IsEmpty(ListItem.DBID) + String.IsEmpty(ListItem.Property(ratingKey)) + String.IsEmpty(ListItem.UniqueID(tmdb)) + String.IsEmpty(ListItem.Property(tmdb_id)) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]">RunPlugin(plugin://plugin.video.plexkodiconnect/?mode=watchlist_status_monitor)</onload>

    <controls>

        <include condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">DialogInfo_VideoButtons</include>

        <control type="button" id="8000">
            <texturenofocus />
            <texturefocus />
            <font />
            <ondown>5000</ondown>
            <onfocus condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">SetFocus(4001)</onfocus>
            <onright condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">4001</onright>
            <onleft condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">4001</onleft>
            <onleft condition="String.IsEqual(ListItem.Property(tmdb_type),person) + $EXP[Exp_TMDbHelper_IsData]">ActivateWindow(1113)</onleft>
            <onright condition="String.IsEqual(ListItem.Property(tmdb_type),person) + $EXP[Exp_TMDbHelper_IsData]">ActivateWindow(1113)</onright>
            <onup condition="$EXP[Exp_TMDbHelper_IsData]">ActivateWindow(1113)</onup>
            <onfocus>ClearProperty(Background.DialogInfo.HideArtwork,Home)</onfocus>
            <onclick condition="String.IsEqual(ListItem.Property(tmdb_type),person) + $EXP[Exp_TMDbHelper_IsData]">ActivateWindow(1113)</onclick>
            <onclick condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">SendClick(8)</onclick>
            <onclick condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">RunScript(plugin.video.themoviedb.helper,close_dialog=1190)</onclick>
        </control>



        <include condition="Window.IsVisible(fullscreenvideo)">OSD_VideoBackground_Dialog</include>

        <control type="group">
            <include>DialogInfo_Main_Group</include>
            <control type="group">
                <include>DialogInfo_Body_Group</include>
                <control type="group">
                    <include content="DialogInfo_Info_Group">
                        <param name="extended_include">DialogInfo_VideoDetails</param>
                        <param name="plotwidth">90%</param>
                    </include>
                </control>
            </control>
            <include>Furniture_Footer_Right</include>
        </control>

        <control type="group">
            <include>DialogInfo_Animation_Down</include>
            <include>DialogInfo_Widget_Group</include>
            <control type="grouplist" id="5000">
                <include>DialogInfo_Widget_Grouplist</include>

                <onup>8000</onup>
                <onback>8000</onback>
                <ondown>330</ondown>

                <include condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">DialogInfo_VideoWidgets</include>
                <include condition="String.IsEqual(ListItem.Property(tmdb_type),person)">DialogInfo_PersonWidgets</include>
                <include condition="!Skin.HasSetting(VideoInfo.Widgets.DisableGallery)">DialogInfo_GalleryWidget</include>


                <include>Widget_End_Bumper</include>
            </control>
        </control>

        <include content="Object_Hidden_Button">
            <param name="id">6</param>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">7</param>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">10</param>
        </include>
        <include content="Object_Hidden_Button">
            <param name="id">15</param>
        </include>


    </controls>
</window>
