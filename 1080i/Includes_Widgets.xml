<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <include name="Widget_Label">
        <param name="usewidgetlabel">false</param>
        <param name="labelvisible">true</param>
        <param name="labeltop">widget_label_t</param>
        <param name="labelheight">widget_label_h</param>
        <definition>
            <control type="group" id="$PARAM[groupid]">
                <nested />
                <top>$PARAM[labeltop]</top>
                <height>$PARAM[labelheight]</height>
                <left>view_pad</left>
                <right>view_pad</right>
                <visible>$PARAM[visible]</visible>

                <include content="View_Line" condition="$PARAM[labelvisible] + ![$PARAM[usewidgetlabel]]">
                    <param name="label">$PARAM[label]</param>
                    <param name="label_fallback">31282</param>
                    <param name="top">20</param>
                    <param name="left">0</param>
                    <param name="visible">!Integer.IsEqual(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating | $PARAM[busy_visible]</param>
                    <param name="use_spinner">true</param>
                    <param name="run_spinner">Container($PARAM[id]).IsUpdating</param>
                </include>
                <include content="View_Line" condition="$PARAM[labelvisible] + [$PARAM[usewidgetlabel]]">
                    <param name="label">$INFO[Container($PARAM[id]).ListItem.Property(widget)]</param>
                    <param name="label_fallback">$PARAM[label]</param>
                    <param name="top">20</param>
                    <param name="left">0</param>
                    <param name="visible">!Integer.IsEqual(Container($PARAM[id]).NumItems,0) | Container($PARAM[id]).IsUpdating | $PARAM[busy_visible]</param>
                    <param name="use_spinner">true</param>
                    <param name="run_spinner">Container($PARAM[id]).IsUpdating</param>
                </include>

                <include content="Widget_Busy">
                    <param name="label">$PARAM[label]</param>
                    <param name="visible">$PARAM[busy_visible]</param>
                    <param name="include">$PARAM[include]</param>
                    <top>10</top>
                </include>

            </control>
        </definition>
    </include>

    <include name="Widget_Content">
        <param name="visible">true</param>
        <param name="altvisible">false</param>
        <param name="include">List_Poster_Row</param>
        <param name="busy_visible">true</param>
        <param name="busy_isupdating">false</param>
        <param name="usewidgetlabel">false</param>
        <param name="widgettop">widget_items_t</param>
        <param name="widgetheight">widget_items_h</param>
        <param name="conditional_fade">false</param>
        <param name="widgetfade_include">false</param>
        <param name="widgetfade_disable">false</param>
        <param name="widget_hideartwork">false</param>
        <param name="widget_showoverlay">false</param>
        <!-- Row-level: detailed rows (cast and crew in the info dialog) overlay their labels on the tile -->
        <param name="detailed">false</param>
        <definition>
            <include content="Widget_Label">
                <param name="groupid">$PARAM[groupid]</param>
                <param name="label">$PARAM[label]</param>
                <param name="id">$PARAM[id]</param>
                <param name="visible">[Container($PARAM[id]).IsUpdating | !Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]] + $PARAM[visible]</param>
                <param name="busy_visible">[Container($PARAM[id]).IsUpdating | $PARAM[busy_isupdating]] + $PARAM[busy_visible]</param>
                <param name="usewidgetlabel">$PARAM[usewidgetlabel]</param>
                <param name="labelvisible">$PARAM[labelvisible]</param>
                <param name="labeltop">$PARAM[labeltop]</param>
                <param name="labelheight">$PARAM[labelheight]</param>
                <param name="include">$PARAM[include]</param>
                <include content="Animation_ConditionalFade">
                    <param name="condition">$PARAM[conditional_fade]</param>
                </include>
                <include content="Animation_Widget_FadeOut" condition="$PARAM[widgetfade_include]">
                    <param name="condition">!Control.HasFocus($PARAM[id]) + !Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),$PARAM[id]) + ![$PARAM[widgetfade_disable]]</param>
                </include>

            </include>
            <include content="$PARAM[include]">
                <param name="id">$PARAM[id]</param>
                <param name="icon">$PARAM[icon]</param>
                <param name="detailed">$PARAM[detailed]</param>
                <!-- Poster rows label their items like landscape rows (title; Detailed adds a subtitle) -->
                <param name="show_labels">true</param>
                <!-- Text labels: Off hides the labels under every widget row -->
                <param name="hide_labels">Skin.HasSetting(View.HideWidgetLabels)</param>
                <param name="item_h">$PARAM[item_h]</param>
                <param name="itemlayout_h">$PARAM[itemlayout_h]</param>
                <param name="item_w">$PARAM[item_w]</param>
                <param name="itemlayout_w">$PARAM[itemlayout_w]</param>
                <param name="hidden_button_enabled">true</param>
                <nested />
                <include content="Object_HitRect">
                    <param name="x">0</param>
                    <param name="y">130</param>
                    <param name="w">1920</param>
                    <param name="h">view_poster_itemlayout_h</param>
                </include>
                <top>$PARAM[widgettop]</top>
                <height>$PARAM[widgetheight]</height>
                <animation effect="fade" start="100" end="0" time="0" condition="[Container($PARAM[id]).IsUpdating | $PARAM[busy_isupdating]] + $PARAM[busy_visible]">Conditional</animation>
                <visible>$PARAM[visible] + [Container($PARAM[id]).IsUpdating | !Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]]</visible>

                <onfocus condition="!$EXP[Exp_InfoDialogs] + $PARAM[widget_hideartwork]">SetProperty(Background.HideArtwork,True)</onfocus>
                <onfocus condition="$EXP[Exp_InfoDialogs] + $PARAM[widget_hideartwork]">SetProperty(Background.DialogInfo.HideArtwork,True,Home)</onfocus>

                <onfocus condition="!$EXP[Exp_InfoDialogs] + ![$PARAM[widget_hideartwork]]">ClearProperty(Background.HideArtwork)</onfocus>
                <onfocus condition="$EXP[Exp_InfoDialogs] + ![$PARAM[widget_hideartwork]]">ClearProperty(Background.DialogInfo.HideArtwork,Home)</onfocus>

                <onfocus condition="!$EXP[Exp_InfoDialogs] + ![$PARAM[widget_showoverlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
                <onfocus condition="!$EXP[Exp_InfoDialogs] + $PARAM[widget_showoverlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>

                <include content="Animation_Widget_FadeOut" condition="$PARAM[widgetfade_include]">
                    <param name="condition">!Control.HasFocus($PARAM[id]) + !Integer.IsEqual(Window.Property(TMDBHelper.WidgetContainer),$PARAM[id]) + ![$PARAM[widgetfade_disable]]</param>
                </include>

                <include content="Animation_ConditionalFade">
                    <param name="condition">$PARAM[conditional_fade]</param>
                </include>
            </include>
            <include content="Widget_LabelsBelow_Spacer">
                <param name="id">$PARAM[id]</param>
                <param name="include">$PARAM[include]</param>
                <param name="detailed">$PARAM[detailed]</param>
                <param name="visible">$PARAM[visible] + [Container($PARAM[id]).IsUpdating | !Integer.IsEqual(Container($PARAM[id]).NumItems,0) | $PARAM[altvisible]]</param>
            </include>
        </definition>
    </include>

    <!--
        Labels below the tile need one rhythm step (view_bar) more row space on the tall
        tile styles, whose item_h (view_poster_item_h, 310) leaves only the 40px gap in
        view_poster_itemlayout_h (350). Landscape and Square tiles are shorter and already
        have room for the labels in their cell, so they never get the spacer.
        labels_below is a row-level rule, because the spacer sits outside the list:
          - the row style draws labels below the tile (Poster, Card, Circle, Banner, Board:
            Exp_LabelsBelow__<include>, decided at load, see below);
          - Text labels is not Off;
          - the row is not detailed (detailed rows overlay their labels on the tile);
          - for Poster and Card rows, the row's first item is not cast or crew
            (DBType actor/video or a role), whose tiles overlay their labels. A row holds
            one kind of item, so the first item stands for the row; ListItemAbsolute(0)
            does not move with focus, so the row height never jumps while scrolling.
        A grouplist only counts visible controls, so a hidden spacer takes no space.
    -->
    <include name="Widget_LabelsBelow_Spacer">
        <param name="detailed">false</param>
        <definition>
            <include content="Object_Control" condition="$EXP[Exp_LabelsBelow__$PARAM[include]]">
                <param name="id">7$PARAM[id]</param>
                <param name="control">group</param>
                <height>view_bar</height>
                <visible>![$PARAM[detailed]] + !Skin.HasSetting(View.HideWidgetLabels) + $PARAM[visible]</visible>
                <include content="Widget_LabelsBelow_CastCheck" condition="$EXP[Exp_LabelsBelow_CastCheck__$PARAM[include]]">
                    <param name="id">$PARAM[id]</param>
                </include>
            </include>
        </definition>
    </include>
    <include name="Widget_LabelsBelow_CastCheck">
        <visible>!String.IsEqual(Container($PARAM[id]).ListItemAbsolute(0).DBType,actor) + !String.IsEqual(Container($PARAM[id]).ListItemAbsolute(0).DBType,video) + String.IsEmpty(Container($PARAM[id]).ListItemAbsolute(0).Property(role))</visible>
    </include>

    <!--
        Tile style of a row include, decided when the window loads. String.IsEqual cannot
        compare two literals (its first argument is resolved as an info label, so
        String.IsEqual(List_Poster_Row,List_Poster_Row) is false), so the row include name
        selects an expression instead: $EXP[Exp_LabelsBelow__$PARAM[include]]. A name with no
        expression resolves to an empty condition, which an include condition treats as false.
        Use them in include conditions only, and negate only the Exp_Wall_* ones, which are
        defined for every row include a wall, row view (500-505) or combined row (520-524) can use.
          Exp_LabelsBelow__            tall tiles that draw their labels below the tile
          Exp_LabelsBelow_CastCheck__  of those, the ones whose cast/crew tiles overlay labels
          Exp_Wall_TallTile__          wall and row view includes whose tile gives view_bar to its labels
          Exp_Wall_CentredLabels__     wall row includes with centred labels (Poster, Circle)
    -->
    <expression name="Exp_LabelsBelow__List_Poster_Row">true</expression>
    <expression name="Exp_LabelsBelow__List_Card_Row">true</expression>
    <expression name="Exp_LabelsBelow__List_Circle_Row">true</expression>
    <expression name="Exp_LabelsBelow__List_Banner_Row">true</expression>
    <expression name="Exp_LabelsBelow__List_Board_Row">true</expression>
    <expression name="Exp_LabelsBelow_CastCheck__List_Poster_Row">true</expression>
    <expression name="Exp_LabelsBelow_CastCheck__List_Card_Row">true</expression>
    <expression name="Exp_Wall_TallTile__List_Poster_Row">true</expression>
    <expression name="Exp_Wall_TallTile__List_Circle_Row">true</expression>
    <expression name="Exp_Wall_TallTile__List_Board_Row">true</expression>
    <expression name="Exp_Wall_TallTile__List_Landscape_Row">false</expression>
    <expression name="Exp_Wall_TallTile__List_Square_Row">false</expression>
    <expression name="Exp_Wall_TallTile__List_Card_Row">true</expression>
    <expression name="Exp_Wall_CentredLabels__List_Poster_Row">true</expression>
    <expression name="Exp_Wall_CentredLabels__List_Circle_Row">true</expression>
    <expression name="Exp_Wall_CentredLabels__List_Board_Row">false</expression>
    <expression name="Exp_Wall_CentredLabels__List_Landscape_Row">false</expression>
    <expression name="Exp_Wall_CentredLabels__List_Square_Row">false</expression>
    <expression name="Exp_Wall_CentredLabels__List_Card_Row">false</expression>

