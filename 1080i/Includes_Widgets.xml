    <!--
        Lazy widget row placeholder (generated Standard-mode rows past the third).
        Until the row is near the focused row its content path is empty, so this
        item keeps the row laid out and focusable; focusing it raises
        Widgets.Reached, which hides the item and gives the row its real path.
        Widget_Row shows the busy spinner while it is the first item.
    -->
    <include name="Widget_Lazy_Placeholder">
        <content>
            <item>
                <label />
                <property name="widget_lazy">true</property>
                <visible>![$PARAM[reached]]</visible>
            </item>
        </content>
    </include>

    <!--
        Lazy widget empty marker (generated Wall and Combined widgets). The selector (601)
        hides a widget without items, which also stops it being a neighbour of the selected
        widget; without a marker an empty widget would then lose its path, get the
        placeholder back, reappear in the selector next to the selected widget, load again
        and drop out again, in a loop. This item stands in for "loaded and empty": it shows
        when the widget has finished loading with no items and then keeps itself (it is the
        only item), so the widget stays reached and keeps its path, and the selector item
        hides on it (widgets_selector.xmltemplate). Real items replace it; it never shows
        while the widget is loading, so the busy placeholders still do.
    -->
    <include name="Widget_Lazy_Empty">
        <content>
            <item>
                <label />
                <property name="widget_lazy_empty">true</property>
                <visible>!Container($PARAM[id]).IsUpdating + [Integer.IsEqual(Container($PARAM[id]).NumItems,0) | [Integer.IsEqual(Container($PARAM[id]).NumItems,1) + String.IsEqual(Container($PARAM[id]).ListItemAbsolute(0).Property(widget_lazy_empty),true)]]</visible>
            </item>
        </content>
    </include>
