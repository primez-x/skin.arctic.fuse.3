<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <!-- Square Wall -->
    <include name="View_510_Square_Wall">
        <include content="View_Wall_Include">
            <param name="id">510</param>
            <param name="include">List_Square_Row</param>
            <param name="viewtype_label">$LOCALIZE[31556]</param>
            <param name="visible">$EXP[Exp_View_510]</param>
        </include>
    </include>

    <!-- Landscape Wall -->
    <include name="View_511_Landscape_Wall">
        <include content="View_Wall_Include">
            <param name="id">511</param>
            <param name="include">List_Landscape_Row</param>
            <param name="viewtype_label">$LOCALIZE[31555]</param>
            <param name="visible">$EXP[Exp_View_511]</param>
        </include>
    </include>

    <!-- Poster Wall -->
    <include name="View_512_Poster_Wall">
        <include content="View_Wall_Include">
            <param name="id">512</param>
            <param name="include">List_Poster_Row</param>
            <param name="viewtype_label">$LOCALIZE[31554]</param>
            <param name="labels_below">true</param>
            <param name="labels_align">center</param>
            <param name="visible">$EXP[Exp_View_512]</param>
        </include>
    </include>

    <!-- Poster Wall Details: the persistent detail panel beside a narrower poster grid.
         Labels below the tiles (Layout_Labels, centred) make each cell one rhythm step taller
         (view_poster_wall_labelled_itemlayout_h, 370) unless Text labels is Off. -->
    <include name="View_515_Poster_Wall_Details">
        <control type="group">
            <visible>Control.IsVisible(515)</visible>
            <include>View_Poster_Wall_Details</include>
            <control type="group">
                <include content="View_515_Grid" condition="!Skin.HasSetting(View.HideWidgetLabels)">
                    <param name="itemlayout_h">view_poster_wall_labelled_itemlayout_h</param>
                </include>
                <include content="View_515_Grid" condition="Skin.HasSetting(View.HideWidgetLabels)">
                    <param name="itemlayout_h">view_poster_wall_itemlayout_h</param>
                </include>
            </control>
        </control>
    </include>

    <include name="View_515_Grid">
        <include content="List_Poster_Row">
            <param name="id">515</param>
            <param name="control">panel</param>
            <param name="orientation">vertical</param>
            <param name="item_w">view_poster_wall_item_w</param>
            <param name="item_h">view_poster_wall_item_h</param>
            <param name="itemlayout_w">view_poster_wall_itemlayout_w</param>
            <param name="itemlayout_h">$PARAM[itemlayout_h]</param>
            <param name="offset_x">view_poster_wall_offset_x</param>
            <param name="offset_y">view_poster_wall_offset_y</param>
            <param name="show_labels">true</param>
            <param name="hide_labels">Skin.HasSetting(View.HideWidgetLabels)</param>
            <param name="labels_align">center</param>
            <param name="indicator_top">-view_poster_wall_indicator_inset</param>
            <param name="indicator_right">-view_poster_wall_indicator_inset</param>
            <param name="indicator_use_top">true</param>
            <preloaditems>0</preloaditems>
            <top>52</top>
            <bottom>-20</bottom>
            <left>view_poster_wall_grid_l</left>
            <right>view_poster_wall_grid_r</right>
            <onright>611</onright>
            <onleft>ActivateWindow(1171)</onleft>
            <pagecontrol>66</pagecontrol>
            <include content="Action_View_Movement_OnBack">
                <param name="id">515</param>
                <param name="onback">True</param>
            </include>
            <visible>$EXP[Exp_View_515]</visible>
            <viewtype label="$LOCALIZE[31558]">wrap</viewtype>
            <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
            <onfocus>SetProperty(Background.ShowOverlay,True,Home)</onfocus>
            <onfocus>SetProperty(InfoPanel.FullSwitch,Wall,Home)</onfocus>
        </include>
    </include>

    <!-- Circle Wall -->
    <include name="View_513_Circle_Wall">
        <include content="View_Wall_Include">
            <param name="id">513</param>
            <param name="include">List_Circle_Row</param>
            <param name="viewtype_label">$LOCALIZE[31557]</param>
            <param name="labels_below">true</param>
            <param name="visible">[$EXP[Exp_View_513]]</param>
        </include>
    </include>

    <!-- Board Wall -->
    <include name="View_514_Board_Wall">
        <include content="View_Wall_Include">
            <param name="id">514</param>
            <param name="include">List_Board_Row</param>
            <param name="viewtype_label">$LOCALIZE[31101]</param>
            <param name="labels_below">true</param>
            <param name="visible">$EXP[Exp_View_514]</param>
        </include>
    </include>

    <!-- Wall Template View
         Every wall labels its tiles with Layout_Labels and follows Text labels (Off hides them).
         labels_below: the tile fills the 350 cell but for the 40px gap (Poster, Circle, Board),
         so the cell grows by one rhythm step (view_poster_labelled_itemlayout_h, 390) while
         labels are on. Square and Landscape tiles are shorter and already fit their labels. -->
    <include name="View_Wall_Include">
        <param name="overlay">true</param>
        <param name="labels_below">false</param>
        <param name="labels_align">left</param>
        <definition>
            <control type="group">
                <visible>Control.IsVisible($PARAM[id])</visible>
                <control type="group">
                    <include content="View_Wall_Panel" condition="$PARAM[labels_below] + !Skin.HasSetting(View.HideWidgetLabels)">
                        <param name="id">$PARAM[id]</param>
                        <param name="include">$PARAM[include]</param>
                        <param name="itemlayout_h">view_poster_labelled_itemlayout_h</param>
                        <param name="labels_align">$PARAM[labels_align]</param>
                        <param name="visible">$PARAM[visible]</param>
                        <param name="viewtype_label">$PARAM[viewtype_label]</param>
                        <param name="overlay">$PARAM[overlay]</param>
                    </include>
                    <include content="View_Wall_Panel" condition="![$PARAM[labels_below]] | Skin.HasSetting(View.HideWidgetLabels)">
                        <param name="id">$PARAM[id]</param>
                        <param name="include">$PARAM[include]</param>
                        <param name="itemlayout_h">view_poster_itemlayout_h</param>
                        <param name="labels_align">$PARAM[labels_align]</param>
                        <param name="visible">$PARAM[visible]</param>
                        <param name="viewtype_label">$PARAM[viewtype_label]</param>
                        <param name="overlay">$PARAM[overlay]</param>
                    </include>
                </control>
            </control>
        </definition>
    </include>

    <include name="View_Wall_Panel">
        <include content="$PARAM[include]">
            <param name="id">$PARAM[id]</param>
            <param name="control">panel</param>
            <param name="orientation">vertical</param>
            <param name="offset_y">view_bar</param>
            <param name="itemlayout_h">$PARAM[itemlayout_h]</param>
            <param name="show_labels">true</param>
            <param name="hide_labels">Skin.HasSetting(View.HideWidgetLabels)</param>
            <param name="labels_align">$PARAM[labels_align]</param>
            <preloaditems>0</preloaditems>
            <top>290</top>
            <bottom>-view_bar</bottom>
            <onright>611</onright>
            <onleft>ActivateWindow(1171)</onleft>
            <pagecontrol>66</pagecontrol>
            <include content="Action_View_Movement_OnBack">
                <param name="id">$PARAM[id]</param>
                <param name="onback">True</param>
            </include>
            <visible>$PARAM[visible]</visible>
            <viewtype label="$PARAM[viewtype_label]">wrap</viewtype>
            <onfocus>ClearProperty(TMDbHelper.WidgetContainer)</onfocus>
            <onfocus condition="![$PARAM[overlay]]">ClearProperty(Background.ShowOverlay,Home)</onfocus>
            <onfocus condition="$PARAM[overlay]">SetProperty(Background.ShowOverlay,True,Home)</onfocus>
            <onfocus>SetProperty(InfoPanel.FullSwitch,Wall,Home)</onfocus>
        </include>
    </include>

    <include name="View_Poster_Wall_Details">
        <control type="group">
            <visible>Control.IsVisible(515)</visible>
            <visible>!Integer.IsEqual(Container.NumItems,0)</visible>
            <left>view_pad</left>
            <top>view_pad</top>
            <width>view_poster_wall_details_w</width>
            <height>920</height>

            <!-- Composed from the canonical Info_* blocks (same components as Info_Panel /
                 View_Row_Info), re-laid-out for the narrow side panel. The vertical grouplist
                 mirrors Info_Panel exactly so spacing/typography stay consistent skin-wide.
                 Height budget (920): title 140 + quality 56 + meta 56 + genre 56 + plot 440 = 748. -->
            <control type="grouplist">
                <top>-20</top>
                <left>-40</left>
                <hitrect x="0" y="0" w="0" h="0" />
                <orientation>vertical</orientation>
                <itemgap>0</itemgap>

                <control type="group" description="Avoid grouplist chop with spacer">
                    <height>20</height>
                </control>

                <!-- Title: text only (TVShowTitle -> Artist -> Title -> Label), no clearlogo,
                     so the title is always readable in this side panel -->
                <include content="Info_Title">
                    <param name="colordiffuse">main_fg</param>
                    <param name="listitem">ListItem</param>
                    <param name="width">view_poster_wall_details_w</param>
                    <param name="use_logo">false</param>
                </include>

                <!-- Row 1: quality pills (resolution / HDR / audio) + star rating. -->
                <include content="Info_Line">
                    <param name="colordiffuse">main_fg</param>
                    <param name="listitem">ListItem</param>
                    <param name="show_meta">false</param>
                    <param name="height">56</param>
                </include>

                <!-- Row 2: meta labels (Premiered / MPAA / Duration / ...).
                     Pulled up (top -16) to tighten against the quality row.
                     Leading dot suppressed; inter-item separators preserved. -->
                <include content="Info_Line">
                    <param name="colordiffuse">main_fg</param>
                    <param name="listitem">ListItem</param>
                    <param name="show_quality">false</param>
                    <param name="leading_divider">false</param>
                    <param name="height">56</param>
                    <param name="top">-16</param>
                </include>

                <!-- Row 3: genre, a bare Info_Line_Label in the Info_Line horizontal-grouplist
                     idiom (font_main, _70). A static label (no fadelabel), capped at the panel
                     width, so a long genre list never scrolls and keeps the GPU redrawing. -->
                <control type="group">
                    <left>40</left>
                    <width>view_poster_wall_details_w</width>
                    <height>56</height>
                    <visible>!String.IsEmpty(ListItem.Genre)</visible>
                    <control type="grouplist">
                        <hitrect x="0" y="0" w="0" h="0" />
                        <orientation>horizontal</orientation>
                        <itemgap>10</itemgap>
                        <left>-20</left>
                        <control type="group" description="Avoid grouplist chop with spacer">
                            <left>-10</left>
                            <width>20</width>
                        </control>
                        <include content="Info_Line_Label">
                            <param name="colordiffuse">main_fg</param>
                            <param name="show_divider">false</param>
                            <param name="label">$INFO[ListItem.Genre]</param>
                            <param name="max_width">view_poster_wall_details_w</param>
                            <param name="visible">!String.IsEmpty(ListItem.Genre)</param>
                        </include>
                    </control>
                </control>

                <!-- Plot: Info_Plot (plotline / episode header included), textbox so a long
                     plot scrolls inside its bound -->
                <include content="Info_Plot">
                    <param name="colordiffuse">main_fg</param>
                    <param name="listitem">ListItem</param>
                    <param name="width">view_poster_wall_details_w</param>
                    <param name="height">440</param>
                    <param name="plotline_height">400</param>
                    <param name="use_textbox">true</param>
                </include>
            </control>
        </control>
    </include>
</includes>
