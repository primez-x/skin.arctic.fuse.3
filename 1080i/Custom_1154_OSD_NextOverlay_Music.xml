<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1154">
    <defaultcontrol always="true">6003</defaultcontrol>
    <controls>
        <control type="group">
            <include>OSD_HideControls</include>
            <visible>$EXP[Exp_OSD_MusicNext_Available]</visible>

            <control type="group">
                <top>view_pad</top>
                <right>view_pad</right>
                <width>850</width>
                <align>right</align>
                <animation type="WindowOpen" reversible="true">
                    <effect type="fade" start="0" end="100" time="300" delay="600" />
                    <effect type="slide" start="48,0" end="0" center="auto" tween="back" easing="out" time="400" delay="600" />
                </animation>
                <animation type="Visible" reversible="true">
                    <effect type="fade" start="0" end="100" time="300" delay="600" />
                    <effect type="slide" start="48,0" end="0" center="auto" tween="back" easing="out" time="400" delay="600" />
                </animation>
                <!-- Album art is square: a square tile as tall as the video overlay's landscape one -->
                <control type="group">
                    <right>0</right>
                    <height>view_landscape_item_h</height>
                    <width>view_landscape_item_h</width>
                    <control type="group">
                        <include>Object_ItemBack</include>
                        <control type="image">
                            <texture background="true" diffuse="diffuse/square_w217_h217.png">$VAR[Image_OSD_MusicNext_Art]</texture>
                            <aspectratio scalediffuse="false">scale</aspectratio>
                        </control>
                    </control>
                </control>
                <control type="grouplist">
                    <right>view_landscape_item_h</right>
                    <width>400</width>
                    <height>view_landscape_item_h</height>
                    <align>right</align>
                    <aligny>center</aligny>
                    <orientation>vertical</orientation>
                    <control type="label">
                        <right>40</right>
                        <textcolor>panel_fg_90</textcolor>
                        <label>$LOCALIZE[31196]$VAR[Label_OSD_MusicNext_Title]</label>
                        <height>40</height>
                        <font>font_main_bold</font>
                        <align>right</align>
                    </control>
                    <control type="label">
                        <right>40</right>
                        <textcolor>panel_fg_70</textcolor>
                        <label>$VAR[Label_OSD_MusicNext_Artist]</label>
                        <height>40</height>
                        <align>right</align>
                    </control>
                </control>
            </control>
            <control type="group">
                <left>view_pad</left>
                <right>view_pad</right>

                <include content="OSD_CustomDialog_GroupList">
                    <param name="onclick">PlayerControl(Next)</param>
                    <param name="icon">$VAR[Image_OSD_SkipNext]</param>
                    <param name="button_3">true</param>

                    <param name="onup">Close</param>
                    <param name="onup_02">SetFocus(8200)</param>
                </include>
            </control>
        </control>
    </controls>
</window>
