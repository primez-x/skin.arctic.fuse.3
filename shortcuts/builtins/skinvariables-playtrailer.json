{
    "infolabels": {
        "listitem_trailer": "Container.ListItem.Trailer",
        "tmdbhelper_trailer": "Window(Home).Property(TMDbHelper.ListItem.Trailer)"
    },
    "values": {
        "trailer": [
            {
                "rules": ["!String.IsEmpty(Container.ListItem.Trailer)"],
                "value": "{listitem_trailer}"
            },
            "{tmdbhelper_trailer}"
        ]
    },
    "actions": [
        "PlayMedia(\"{trailer}\")"
    ]
}
